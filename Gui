-- 4. Flower Farm Loop
task.spawn(function()
    while true do
        if flags.flower then
            pcall(function()
                local folder = workspace:FindFirstChild("Entities")
                folder = folder and folder:FindFirstChild("Interactions")
                folder = folder and folder:FindFirstChild("Collectibles")
                folder = folder and folder:FindFirstChild("Flowers")
                
                if not folder then return end

                local HRP = getRoot()
                if not HRP then return end

                local flowers = {}
                for _, v in ipairs(folder:GetDescendants()) do
                    if getPrompt(v) then table.insert(flowers, v) end
                end

                table.sort(flowers, function(a, b)
                    local aLily = a.Name:lower():find("lily") ~= nil
                    local bLily = b.Name:lower():find("lily") ~= nil
                    if aLily ~= bLily then return aLily end
                    return a.Name < b.Name
                end)

                for _, flower in ipairs(flowers) do
                    if not flags.flower then break end
                    local part = getPart(flower)
                    local prompt = getPrompt(flower)

                    if part and prompt then
                        HRP.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                        local startTime = tick()
                        while flags.flower and tick() - startTime < FLOWER_DELAY do
                            if prompt and prompt.Parent then fireproximityprompt(prompt) end
                            task.wait()
                        end
                    end
                end

                if flags.flower then
                    HRP.CFrame = CFrame.new(SAFEZONE)
                    local elapsed = 0
                    while flags.flower and elapsed < LOOP_DELAY do
                        task.wait(0.1)
                        elapsed = elapsed + 0.1
                    end
                end
            end)
        else
            task.wait(0.5)
        end
    end
end)

-- 5. Auto Walk & Reset Connection
local phaseStartTime = os.clock()
local characterResetTriggered = false

RunService.RenderStepped:Connect(function()
    if not flags.walk then 
        characterResetTriggered = false
        return 
    end
    
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local primaryPart = character and character.PrimaryPart
    
    if humanoid and primaryPart and humanoid.Health > 0 then
        local elapsed = os.clock() - phaseStartTime
        
        if elapsed < MOVE_DURATION then
            local moveDirection = primaryPart.CFrame.LookVector
            humanoid:Move(moveDirection, false)
        elseif elapsed < RESET_TIME then
            humanoid:Move(Vector3.new(0, 0, 0), false)
        else
            if not characterResetTriggered then
                characterResetTriggered = true
                humanoid.Health = 0
            end
        end
    else
        phaseStartTime = os.clock()
        characterResetTriggered = false
    end
end)

-- 6. Dynamic Tracer Folder Setup for Kill Aura
local tracerFolder = workspace:FindFirstChild("KillAuraTracers")
if not tracerFolder then
    tracerFolder = Instance.new("Folder")
    tracerFolder.Name = "KillAuraTracers"
    tracerFolder.Parent = workspace
end

local activeBeams = {}

local function updateTracer(enemyPart, active)
    if active then
        local beam = activeBeams[enemyPart]
        if not beam or not beam.Parent then
            local attachment0 = Instance.new("Attachment")
            attachment0.Parent = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            
            local attachment1 = Instance.new("Attachment")
            attachment1.Parent = enemyPart
            
            beam = Instance.new("Beam")
            beam.Attachment0 = attachment0
            beam.Attachment1 = attachment1
            beam.Color = ColorSequence.new(Color3.fromRGB(255, 50, 50))
            beam.Width0 = 0.2
            beam.Width1 = 0.2
            beam.FaceCamera = true
            beam.Parent = tracerFolder
            
            activeBeams[enemyPart] = beam
        end
    else
        if activeBeams[enemyPart] then
            activeBeams[enemyPart]:Destroy()
            activeBeams[enemyPart] = nil
        end
    end
end

-- 7. High-Reliability Kill Aura Loop with Tracers
task.spawn(function()
    while true do
        task.wait(0.2)
        
        -- Clean up stale tracers if toggle is off
        if not flags.killAura then
            for part, beam in pairs(activeBeams) do
                if beam then beam:Destroy() end
                activeBeams[part] = nil
            end
        else
            pcall(function()
                local enemiesFolder = workspace:FindFirstChild("Entities")
                enemiesFolder = enemiesFolder and enemiesFolder:FindFirstChild("Enemies")
                
                local root = getRoot()
                if not enemiesFolder or not root then return end

                local nameCounts = {}
                local enemyInstances = enemiesFolder:GetChildren()
                
                for _, enemy in ipairs(enemyInstances) do
                    nameCounts[enemy.Name] = (nameCounts[enemy.Name] or 0) + 1
                end

                local currentInRange = {}

                for _, enemy in ipairs(enemyInstances) do
                    if not flags.killAura then break end
                    
                    local humanoid = enemy:FindFirstChildOfClass("Humanoid")
                    local hrp = enemy:FindFirstChild("HumanoidRootPart")
                    
                    if humanoid and hrp and humanoid.Health > 0 then
                        local distance = (root.Position - hrp.Position).Magnitude
                        if distance <= KILL_AURA_RANGE then
                            currentInRange[hrp] = true
                            updateTracer(hrp, true)
                            
                            local isBoss = (nameCounts[enemy.Name] == 1)
                            
                            -- Position alignment for reliable hit registration
                            root.CFrame = hrp.CFrame + Vector3.new(0, 0, 3)
                            
                            pcall(function()
                                remote:FireServer("Attack", enemy)
                                remote:FireServer("Damage", enemy, humanoid.MaxHealth)
                            end)
                            
                            humanoid.Health = 0
                        else
                            updateTracer(hrp, false)
                        end
                    end
                end

                -- Remove beams for out-of-range or dead entities
                for part, _ in pairs(activeBeams) do
                    if not currentInRange[part] then
                        updateTracer(part, false)
                    end
                end
            end)
        end
    end
end)

