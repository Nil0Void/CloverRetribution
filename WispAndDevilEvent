-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local TextChatService = game:GetService("TextChatService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer

-- Config File Setup
local ConfigFile = "WispFarmer_Webhook.txt"
local Settings = {
    Enabled = false,
    WebhookURL = "",
    CheckInterval = 1.0, -- Lower frequency to eliminate lag
}

-- Load Saved Webhook URL
if readfile and isfile and isfile(ConfigFile) then
    pcall(function()
        Settings.WebhookURL = readfile(ConfigFile)
    end)
end

-- Save Webhook URL Helper
local function saveWebhook(url)
    Settings.WebhookURL = url
    if writefile then
        pcall(function()
            writefile(ConfigFile, url)
        end)
    end
end

-- Executor HTTP Request Support
local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request

-- Send Discord Notification
local function sendDiscordWebhook(messageText)
    if Settings.WebhookURL == "" or not httpRequest then return end
    
    local payload = HttpService:JSONEncode({
        content = "@everyone 🚨 **Roblox Event Alert**",
        embeds = {{
            title = "In-Game Event Triggered!",
            description = messageText,
            color = 16711680,
            footer = { text = "Wisp Farmer Bot • " .. os.date("%X") }
        }}
    })
    
    task.spawn(function()
        pcall(function()
            httpRequest({
                Url = Settings.WebhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = payload
            })
        end)
    end)
end

-- Chat Event Listener
local function setupChatListener()
    TextChatService.OnIncomingMessage = function(message)
        if message.Text and string.find(message.Text, "%[Event%] Something feels off%.%.%.") then
            sendDiscordWebhook(message.Text)
        end
    end

    local chatEvents = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
    if chatEvents then
        local onMessage = chatEvents:FindFirstChild("OnMessageDoneFiltering")
        if onMessage and onMessage:IsA("RemoteEvent") then
            onMessage.OnClientEvent:Connect(function(messageData)
                local msg = messageData.Message or ""
                if string.find(msg, "%[Event%] Something feels off%.%.%.") then
                    sendDiscordWebhook(msg)
                end
            end)
        end
    end
end
setupChatListener()

-- Interaction Helper
local function interactWithTarget(target)
    for _, prompt in ipairs(target:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:InputHoldBegin()
                task.wait(prompt.HoldDuration)
                prompt:InputHoldEnd()
            end
        end
    end
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

-- Check if Object name ends with or contains "Wisp"
local function isWispTarget(obj)
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return false end
    local lowerName = string.lower(obj.Name)
    return string.sub(lowerName, -4) == "wisp" or string.find(lowerName, "wisp") ~= nil
end

-- Process and Farm Target
local function farmWisp(obj)
    if not Settings.Enabled then return end
    
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
    if targetPart then
        while Settings.Enabled and obj:IsDescendantOf(Workspace) do
            hrp.CFrame = targetPart.CFrame * CFrame.new(0, 1.5, 0)
            interactWithTarget(obj)
            task.wait(0.05)
        end
    end
end

-- Auto-Farm Event Listener (Event-driven to stop lag)
Workspace.DescendantAdded:Connect(function(descendant)
    if Settings.Enabled and isWispTarget(descendant) then
        task.spawn(farmWisp, descendant)
    end
end)

-- Background Scan (Runs smoothly without freezing)
local function scanAndFarm()
    while Settings.Enabled do
        for _, obj in ipairs(Workspace:GetChildren()) do
            if isWispTarget(obj) then
                farmWisp(obj)
            end
        end
        task.wait(Settings.CheckInterval)
    end
end

