-- Wisp Priority Target Utilities
local function isWispTarget(obj)
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return false end
    local lowerName = string.lower(obj.Name)
    return string.sub(lowerName, -4) == "wisp" or string.find(lowerName, "wisp") ~= nil
end

local function getActiveWisp()
    if not WISP_ACTIVE then return nil, nil end
    for _, obj in ipairs(workspace:GetChildren()) do
        if isWispTarget(obj) then
            local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)) or obj
            if targetPart then
                return obj, targetPart
            end
        end
    end
    return nil, nil
end

