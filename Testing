-- Flower Harvesting Sub-Engine
local FLOWER_DELAY = 1.5

local function getActiveFlowerTarget()
    if not FLOWER_ACTIVE or getActiveWisp() ~= nil then return nil, nil end
    local folder = workspace:FindFirstChild("Entities")
    folder = folder and folder:FindFirstChild("Interactions")
    folder = folder and folder:FindFirstChild("Collectibles")
    folder = folder and folder:FindFirstChild("Flowers")
    if not folder then return nil, nil end

    local flowers = {}
    for _, v in ipairs(folder:GetDescendants()) do
        local prompt = v:FindFirstChildOfClass("ProximityPrompt") or v:FindFirstChild("ProximityPrompt", true)
        if prompt then table.insert(flowers, v) end
    end

    table.sort(flowers, function(a, b)
        local aLily = a.Name:lower():find("lily") ~= nil
        local bLily = b.Name:lower():find("lily") ~= nil
        if aLily ~= bLily then return aLily end
        return a.Name < b.Name
    end)

    for _, flower in ipairs(flowers) do
        local part = flower:IsA("BasePart") and flower or flower:FindFirstChild("Handle") or flower:FindFirstChildWhichIsA("BasePart", true)
        local prompt = flower:FindFirstChildOfClass("ProximityPrompt") or flower:FindFirstChild("ProximityPrompt", true)
        if part and prompt and prompt.Parent then return part, prompt end
    end
    return nil, nil
end

task.spawn(function()
    while true do
        if FLOWER_ACTIVE and not getActiveWisp() then
            pcall(function()
                local flowerPart, flowerPrompt = getActiveFlowerTarget()
                if flowerPart and flowerPrompt then
                    local character = player.Character
                    local myRoot = character and character:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        if not flyAnchor or flyAnchor.Parent ~= myRoot then
