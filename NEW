    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local sliderBg = Instance.new("Frame")
    sliderBg.Size = UDim2.new(1, -20, 0, 8)
    sliderBg.Position = UDim2.new(0, 10, 0, yOffset + 20)
    sliderBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    sliderBg.Parent = frame

    local sliderBtn = Instance.new("TextButton")
    sliderBtn.Size = UDim2.new(0, 16, 0, 16)
    sliderBtn.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
    sliderBtn.Text = ""
    sliderBtn.Parent = sliderBg

    local function refreshSliderVisuals()
        local liveValue = (axisName == "🔄 Orbit Position" and currentOffset.X) or (axisName == "📐 Height" and currentOffset.Y) or currentOffset.Z
        label.Text = axisName .. ": " .. tostring(liveValue) .. ((axisName:find("Orbit") and "°") or " studs")
        sliderBtn.Position = UDim2.new((liveValue - minVal) / (maxVal - minVal), -8, 0.5, -8)
    end
    refreshSliderVisuals()

    local activeDragging = false
    sliderBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeDragging = true
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if activeDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local clmp = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
            local val = math.round(minVal + (clmp * (maxVal - minVal)))
            if axisName == "🔄 Orbit Position" then currentOffset = Vector3.new(val, currentOffset.Y, currentOffset.Z)
            elseif axisName == "📐 Height" then currentOffset = Vector3.new(currentOffset.X, val, currentOffset.Z)
            else currentOffset = Vector3.new(currentOffset.X, currentOffset.Y, val) end
            refreshSliderVisuals()
            saveConfig()
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeDragging = false
        end
    end)
end

