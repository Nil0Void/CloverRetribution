-- ============================================================================
-- DYNAMIC ENEMY DETECTION (lag-free, event-driven)
-- ============================================================================
local detectedEnemies = {}
local enemyButtons = {}
local pendingUIUpdate = false

local function scheduleUIRefresh()
    if pendingUIUpdate then return end
    pendingUIUpdate = true
    task.defer(function()
        task.wait(0.25) -- bigger debounce on mobile
        pendingUIUpdate = false

        -- Remove buttons for enemies that no longer exist
        for enemyName, btn in pairs(enemyButtons) do
            if not detectedEnemies[enemyName] then
                btn:Destroy()
                enemyButtons[enemyName] = nil
            end
        end

        -- Add buttons for new enemies
        for enemyName, _ in pairs(detectedEnemies) do
            if not enemyButtons[enemyName] then
                local mobBtn = Instance.new("TextButton")
                mobBtn.Size = UDim2.new(0, 190, 0, 30)
                mobBtn.Font = Enum.Font.SourceSans
                mobBtn.TextSize = 13
                mobBtn.Parent = enemyContainer

                if not targets.Mobs[enemyName] then
                    targets.Mobs[enemyName] = "OFF"
                end

                local function refreshVisuals()
                    local state = targets.Mobs[enemyName]
                    if state == "ON" then
                        mobBtn.Text = enemyName .. " [ON]"
                        mobBtn.BackgroundColor3 = Color3.fromRGB(56, 92, 145)
                    elseif state == "PRIORITY" then
                        mobBtn.Text = "⭐ " .. enemyName .. " [PRIO]"
                        mobBtn.BackgroundColor3 = Color3.fromRGB(168, 126, 42)
                    else
                        mobBtn.Text = enemyName .. " [OFF]"
                        mobBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
                    end
                end
                refreshVisuals()

                mobBtn.MouseButton1Click:Connect(function()
                    local cur = targets.Mobs[enemyName]
                    targets.Mobs[enemyName] = (cur == "OFF" and "ON") or (cur == "ON" and "PRIORITY") or "OFF"
                    currentTarget = nil
                    refreshVisuals()
                    saveConfig()
                end)

                enemyButtons[enemyName] = mobBtn
            end
        end

        if enemyLayout then
            enemyContainer.CanvasSize = UDim2.new(0, 0, 0, enemyLayout.AbsoluteContentSize.Y + 10)
        end
    end)
end

task.spawn(function()
    local entities = workspace:WaitForChild("Entities", 15)
    if not entities then return end
    local enemiesFolder = entities:WaitForChild("Enemies", 15)
    if not enemiesFolder then return end

    local function registerEnemy(model)
        if not model:IsA("Model") then return end
        if not detectedEnemies[model.Name] then
            detectedEnemies[model.Name] = true
            scheduleUIRefresh()
        end
    end

    local function unregisterEnemy(model)
        if not model:IsA("Model") then return end
        local stillExists = false
        for _, child in ipairs(enemiesFolder:GetChildren()) do
            if child.Name == model.Name and child ~= model then
                stillExists = true
                break
            end
        end
        if not stillExists then
            detectedEnemies[model.Name] = nil
            scheduleUIRefresh()
        end
    end

    for _, child in ipairs(enemiesFolder:GetChildren()) do registerEnemy(child) end
    enemiesFolder.ChildAdded:Connect(registerEnemy)
    enemiesFolder.ChildRemoved:Connect(unregisterEnemy)
end)

