local function updateButtonVisual(button, isActive, activeColor, inactiveColor, textPrefix)
    button.BackgroundColor3 = isActive and activeColor or inactiveColor
    button.Text = textPrefix .. (isActive and ": ON" or ": OFF")
end

local function isMobSpawned(mobName)
    local entities = Workspace:FindFirstChild("Entities")
    local enemies = entities and entities:FindFirstChild("Enemies")
    if enemies then
        for _, enemy in ipairs(enemies:GetChildren()) do
            if string.find(enemy.Name, mobName) then
                return true
            end
        end
    end
    return false
end

-- UNIVERSAL CANCELLABLE INSTANT INTERACT
local function instantTpAndInteract(targetInstance, duration, loopFlagCheck)
    local startTime = os.clock()
    
    -- Smart Part Locator: Gets the actual visual part whether target is a Model or a BasePart
    local targetPart = nil
    if targetInstance:IsA("BasePart") then
        targetPart = targetInstance
    elseif targetInstance:IsA("Model") then
        targetPart = targetInstance.PrimaryPart or targetInstance:FindFirstChildWhichIsA("BasePart")
    end
    
    if not targetPart then return end

    -- Extract interactable items
    local prompts = {}
    local clickDetectors = {}
    for _, obj in ipairs(targetInstance:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then table.insert(prompts, obj)
        elseif obj:IsA("ClickDetector") then table.insert(clickDetectors, obj) end
    end

    while os.clock() - startTime < duration do
        if not _G[loopFlagCheck] or isMobSpawned("Golem") then break end
        
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            rootPart.CFrame = targetPart.CFrame
        end
        
        for i = 1, #prompts do
            local prompt = prompts[i]
            prompt:InputHoldBegin()
            prompt:InputHoldEnd()
        end
        
        for i = 1, #clickDetectors do
            if fireclickdetector then fireclickdetector(clickDetectors[i]) end
        end
        
        task.wait() 
    end
end

