local function updateButtonVisual(button, isActive, activeColor, inactiveColor, textPrefix)
    button.BackgroundColor3 = isActive and activeColor or inactiveColor
    button.Text = textPrefix .. (isActive and ": ON" or ": OFF")
end

-- Faster checking helper for mobs
local function isMobSpawned(mobName)
    local entities = Workspace:FindFirstChild("Entities")
    local enemies = entities and entities:FindFirstChild("Enemies")
    if enemies then
        for _, enemy in ipairs(enemies:GetChildren()) do
            if string.find(enemy.Name, mobName) then
                return true
            end
        end
    end
    return false
end

-- INSTANT SPAM Teleport and Interact Routine
local function instantTpAndInteract(targetPart, duration, loopFlagCheck)
    local startTime = os.clock()
    
    -- Cache target elements to prevent looking them up millions of times a second
    local prompts = {}
    local clickDetectors = {}
    for _, obj in ipairs(targetPart:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            table.insert(prompts, obj)
        elseif obj:IsA("ClickDetector") then
            table.insert(clickDetectors, obj)
        end
    end

    while os.clock() - startTime < duration do
        -- Instant safety exit checks
        if not _G[loopFlagCheck] or isMobSpawned("Golem") then break end
        
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            rootPart.CFrame = targetPart.CFrame
        end
        
        -- Instantaneous ProximityPrompt Trigger
        for i = 1, #prompts do
            local prompt = prompts[i]
            prompt:InputHoldBegin()
            prompt:InputHoldEnd() -- Fires the interaction instantly without a sleep delay
        end
        
        -- Instantaneous ClickDetector Trigger (Executor environment dependent)
        for i = 1, #clickDetectors do
            if fireclickdetector then
                fireclickdetector(clickDetectors[i])
            end
        end
        
        task.wait() -- Safely yields to the next engine frame so the mobile CPU doesn't crash
    end
end

-- ============================================================================
-- ICE GOLEM LOOP
-- ============================================================================
local function startIceGolemLoop()
    _G.IceLoopRunning = true
    task.spawn(function()
        local map = Workspace:FindFirstChild("Map")
        local zone = map and map:FindFirstChild("IceGolemZone")
        local activation = zone and zone:FindFirstChild("Activation")

        while iceGolemActive do
            character = player.Character or player.CharacterAdded:Wait()
            
            if isMobSpawned("Ice Golem") then
                iceButton.Text = "Ice Golem: Waiting..."
                while isMobSpawned("Ice Golem") and iceGolemActive do
                    task.wait(0.5)
                end
                if not iceGolemActive then break end
                iceButton.Text = "Ice Golem: ON"
            end
            
            if activation then
                for i = 1, 5 do
                    if not iceGolemActive or isMobSpawned("Ice Golem") then break end
                    local crystal = activation:FindFirstChild("Normal_IceCrystal" .. i)
                    if crystal and crystal:IsA("BasePart") then
                        instantTpAndInteract(crystal, 4, "IceLoopRunning")
                    end
                end
            else
                task.wait(1)
            end
            task.wait()
        end
        _G.IceLoopRunning = false
    end)
end

iceButton.MouseButton1Click:Connect(function()
