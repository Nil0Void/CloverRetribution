    end
end)

-- ============================================================================
-- AETHERSTONE GOLEM LOOP
-- ============================================================================
local function startAetherstoneLoop()
    _G.AetherLoopRunning = true
    task.spawn(function()
        local entities = Workspace:FindFirstChild("Entities")
        local interactions = entities and entities:FindFirstChild("Interactions")
        local specialEvents = interactions and interactions:FindFirstChild("SpecialEvents")

        -- Explicit list of the exact runes you requested
        local runesOrder = {
            "Rune of Colossal Wrath",
            "Rune of Endless Challenge",
            "Rune of Raging Tempest",
            "Rune of Shattered Earth"
        }

        while aetherstoneActive do
            character = player.Character or player.CharacterAdded:Wait()
            
            if isMobSpawned("Aetherstone Golem") then
                aetherButton.Text = "Aetherstone: Waiting..."
                while isMobSpawned("Aetherstone Golem") and aetherstoneActive do
                    task.wait(0.5)
                end
                if not aetherstoneActive then break end
                aetherButton.Text = "Aetherstone: ON"
            end
            
            if specialEvents then
                for _, runeName in ipairs(runesOrder) do
                    if not aetherstoneActive or isMobSpawned("Aetherstone Golem") then break end
                    
                    local rune = specialEvents:FindFirstChild(runeName)
                    if rune and (rune:IsA("BasePart") or rune:FindFirstChildWhichIsA("BasePart")) then
                        -- Handle instances where the rune folder has a primary part or is a part itself
                        local targetPart = rune:IsA("BasePart") and rune or rune:FindFirstChildWhichIsA("BasePart")
                        if targetPart then
                            instantTpAndInteract(targetPart, 4, "AetherLoopRunning")
                        end
                    end
                end
            else
                task.wait(1)
            end
            task.wait()
        end
        _G.AetherLoopRunning = false
    end)
end

