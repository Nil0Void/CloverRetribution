-- FIXED ICE GOLEM LOOP
-- ============================================================================
local function startIceGolemLoop()
    _G.IceLoopRunning = true
    task.spawn(function()
        -- Dynamic deep path check
        local map = Workspace:FindFirstChild("Map")
        local iceZone = map and map:FindFirstChild("IceGolemZone")
        local activation = iceZone and iceZone:FindFirstChild("Activation")

        while iceGolemActive do
            character = player.Character or player.CharacterAdded:Wait()
            
            if isMobSpawned("Ice Golem") then
                iceButton.Text = "Ice Golem: Waiting..."
                while isMobSpawned("Ice Golem") and iceGolemActive do
                    task.wait(0.5)
                end
                if not iceGolemActive then break end
                iceButton.Text = "Ice Golem: ON"
            end
            
            if activation then
                for i = 1, 5 do
                    if not iceGolemActive or isMobSpawned("Ice Golem") then break end
                    
                    local crystal = activation:FindFirstChild("Normal_IceCrystal" .. i)
                    if crystal then
                        instantTpAndInteract(crystal, 4, "IceLoopRunning")
                    end
                end
            else
                -- Fallback alert on button text if setup path is missing completely
                iceButton.Text = "Path Error! Check Workspace"
                task.wait(1)
            end
            task.wait()
        end
        _G.IceLoopRunning = false
    end)
end

iceButton.MouseButton1Click:Connect(function()
