    -- Safe, infinite wait for Map assets to load onto mobile client
    local map = Workspace:WaitForChild("Map", 15)
    if map then
        local iceZone = map:WaitForChild("IceGolemZone", 10)
        if iceZone then
            -- Handle boss zone cleanup
            local bossZone = iceZone:WaitForChild("IceBossZone", 5)
            if bossZone then
                local walls = bossZone:FindFirstChild("InvisBossRoomWalls")
                if walls then walls:Destroy() end

                local roof = bossZone:FindFirstChild("RoofParts")
                if roof then roof:Destroy() end
                print("[Success] IceBossZone clutter successfully removed!")
            end
        end
    else
        warn("[Error] Could not find Workspace.Map after 15 seconds. Check game path names!")
    end
end)

